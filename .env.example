# Настройки запуска party_crm в Docker.
# Скопируйте файл в .env (cp .env.example .env) и заполните значения.
# .env в .gitignore — не коммитить.

# Обязательные
SECRET_KEY=change-me-long-random-string
DB_PASSWORD=change-me-db-password

# База данных (дефолты совпадают с setup.sh; в контейнере DB_HOST=db задаёт compose)
#DB_NAME=party_crm_db
#DB_USER=party_crm
#DB_PORT=5432

# Режим
#DEBUG=0
# Домены через запятую
ALLOWED_HOSTS=localhost,127.0.0.1
# HTTPS=1 включает SECURE_SSL_REDIRECT, secure-куки и HSTS (включайте за TLS-прокси)
#HTTPS=0

# Число воркеров gunicorn
#GUNICORN_WORKERS=3

# Почта для отправки отчётов
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
#EMAIL_USE_TLS=1

# Получатели месячного отчёта, адреса через запятую
REPORT_MONTH_EMAIL=recipient@example.com
